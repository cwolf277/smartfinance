# Plaid sandbox credentials (https://dashboard.plaid.com/team/keys)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox

# Database — defaults to local SQLite if unset
DATABASE_URL=sqlite:///data/smartfinance.db

# ML
MODEL_PATH=data/overspend_model.joblib

# Privacy / Flask
MASK_PII=true
FLASK_DEBUG=1
PORT=5000
